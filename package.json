{
  "name": "broadway-pixels-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-static.mjs",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:migrate:local": "wrangler d1 migrations apply broadwaypixels-prod --local",
    "cf:migrate:remote": "wrangler d1 migrations apply broadwaypixels-prod --remote",
    "start": "node server.mjs",
    "test": "node --test",
    "build:accounts": "node scripts/build-accounts.mjs",
    "deploy:accounts": "npm run build:accounts && wrangler deploy --config wrangler.accounts.jsonc"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "^4.127.1"
  },
  "dependencies": {
    "esbuild": "0.25.12",
    "firebase": "12.18.0"
  }
}
